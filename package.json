{
  "name": "agent-rewind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build:sdk": "npm run build --prefix packages/rewind-sdk",
    "build:sdk:cdn": "vite build --config vite.sdk.config.ts",
    "build": "npm run build:sdk && npm run build:sdk:cdn && tsc -b && vite build && node scripts/copy-sdk-to-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
