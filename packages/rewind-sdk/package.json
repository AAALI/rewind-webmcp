{
  "name": "@rewind/webmcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Background Git-style commits, restore, and branching for WebMCP tools.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliabdulkadirali/rewind-webmcp.git",
    "directory": "packages/rewind-sdk"
  },
  "homepage": "https://rewind-webmcp.netlify.app",
  "keywords": [
    "webmcp",
    "mcp",
    "agents",
    "undo",
    "history",
    "audit",
    "state-management"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
